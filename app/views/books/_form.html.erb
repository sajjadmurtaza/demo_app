<%= form_with(model: book) do |form| %>
  <% if book.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(book.errors.count, "error") %> prohibited this book from being saved:</h2>

      <ul>
        <% book.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.number_field :uid, placeholder: 'UID' %>
  </div><br />

  <div class="field">
    <%= form.text_field :title, placeholder: 'Title' %>
  </div><br />

  <div class="field">
    <%= form.text_area :description, placeholder: 'Description' %>
  </div><br />

  <div class="field">
    <%= form.text_field :price, placeholder: 'price e.g. 12.49' %>
  </div><br />

  <div class="field">
    is it free book?
    <%= form.check_box :free %>
  </div>
  <hr />

  Tags:<br />
  <%= select_tag "tagging_ids", options_from_collection_for_select(Tag.all, "id", "name"), :multiple => true %>

  <%#= form.collection_check_boxes :tagging_ids, Tag.all, :id, :name %>
  <hr />
  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
