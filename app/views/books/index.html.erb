Search/Filter:

<%= form_with(url: '/books', method: 'get', local: true) do %>
  Price: <%= text_field_tag(:price) %>
  Tags: <%= select_tag "tag_ids", options_from_collection_for_select(Tag.all, "id", "name"), :multiple => true %>
  <%= submit_tag("Search") %>
<% end %>

<br /><hr />
<table class="table">
  <thead>
    <tr>
      <th scope="col">UID</th>
      <th scope="col">Title</th>
      <th scope="col">Description</th>
      <th scope="col">Price</th>
      <th scope="col">Is it Free?</th>
      <th scope="col">Tags</th>
      <th scope="col" colspan="2"></th>
    </tr>
  </thead>
  <tbody>
    <%= render @books %>
  </tbody>
</table>

<%= link_to "New Book", new_book_path, class: "btn btn-success" %>
